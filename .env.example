# ── LLM de conversación (cualquier endpoint compatible con OpenAI) ────────
# api.openai.com directamente, o OpenRouter:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=openai/gpt-4o-mini   ← id "vendor/model" en OpenRouter
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ── Voz → texto (OpenAI) ─────────────────────────────────────────────────
# whisper-1 | gpt-4o-mini-transcribe (por defecto). Idioma fijo opcional
# (nombre ISO 639-1, p. ej. "es"); sin él se auto-detecta.
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_STT_LANGUAGE=

# ── Texto → voz (OpenAI; TTS_BACKEND=kokoro vuelve al local si está) ─────
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# TTS_BACKEND=openai

# ── Web server ───────────────────────────────────────────────────────────
# PORT=8000
# TEMPERATURE=0.7 — 0 = determinista; el decisor de acciones SIEMPRE corre a 0.
# HISTORY_ROTATE_TOKENS=24000 — rota el historial viejo a partir de este tamaño.

# ── Background reasoner (delegación) ─────────────────────────────────────
# Cuando una pregunta necesita web o investigación profunda, el modelo de
# voz la entrega a un modelo frontier en cualquier endpoint compatible con
# OpenAI y devuelve la respuesta a la conversación. Apagado a menos que
# REASONER_API_KEY esté puesta (o se sirva desde la clave principal).
# REASONER_API_KEY=sk-or-...
# REASONER_BASE_URL=https://openrouter.ai/api/v1
# REASONER_MODEL=anthropic/claude-sonnet-4.5
# En OpenRouter, web search se activa añadiendo ':online' al id del modelo
# (pon 0 para desactivar):
# REASONER_WEB_SEARCH=1
# REASONER_TIMEOUT=90
